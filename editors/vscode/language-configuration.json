{
  "comments": {
    "lineComment": ";"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["\"", "\""]
  ],
  "onEnterRules": [
    {
      "beforeText": "^\\s*((pub\\s+)?(fn|enum)|if|else|else\\s+if|while|for|resource|surface|evolve|match|transaction|try|catch)\\b.*$",
      "action": { "indent": "indent" }
    }
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*((pub\\s+)?(fn|enum)|if|else|else\\s+if|while|for|resource|surface|evolve|match|transaction|try|catch)\\b.*$",
    "decreaseIndentPattern": "^\\s*(else|else\\s+if|catch)\\b.*$"
  }
}
