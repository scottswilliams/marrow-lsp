{
  "name": "marrow",
  "displayName": "Marrow",
  "description": "Language support for the Marrow .mw language, backed by the marrow-lsp server.",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "publisher": "scottswilliams",
  "repository": {
    "type": "git",
    "url": "https://github.com/scottswilliams/marrow-lsp"
  },
  "bugs": {
    "url": "https://github.com/scottswilliams/marrow-lsp/issues"
  },
  "homepage": "https://github.com/scottswilliams/marrow-lsp#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:marrow",
    "workspaceContains:**/marrow.json",
    "onDebugResolve:marrow",
    "onDebugDynamicConfigurations:marrow"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "marrow",
          "title": "Marrow",
          "icon": "$(database)"
        }
      ]
    },
    "views": {
      "marrow": [
        {
          "id": "marrowData",
          "name": "Marrow Data"
        }
      ]
    },
    "commands": [
      {
        "command": "marrow.refreshData",
        "title": "Refresh",
        "category": "Marrow",
        "icon": "$(refresh)"
      },
      {
        "command": "marrow.checkDataIntegrity",
        "title": "Marrow: Check Stored Data Integrity (Advisory)",
        "category": "Marrow"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "marrow.refreshData",
          "when": "view == marrowData",
          "group": "navigation"
        }
      ]
    },
    "languages": [
      {
        "id": "marrow",
        "aliases": [
          "Marrow"
        ],
        "extensions": [
          ".mw"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/marrow.svg",
          "dark": "./icons/marrow.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "marrow",
        "scopeName": "source.marrow",
        "path": "./syntaxes/marrow.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[marrow]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "semanticTokenTypes": [
      {
        "id": "savedRoot",
        "superType": "variable",
        "description": "Saved data root"
      },
      {
        "id": "booleanLiteral",
        "superType": "keyword",
        "description": "Boolean literal"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "marrow",
        "scopes": {
          "namespace": [
            "entity.name.namespace.marrow"
          ],
          "namespace.defaultLibrary": [
            "support.namespace.builtin.marrow",
            "entity.name.namespace.marrow"
          ],
          "function": [
            "entity.name.function.marrow"
          ],
          "function.defaultLibrary": [
            "support.function.builtin.marrow",
            "entity.name.function.marrow"
          ],
          "struct": [
            "entity.name.type.struct.marrow",
            "entity.name.type.resource.marrow",
            "entity.name.type.marrow"
          ],
          "enum": [
            "entity.name.type.enum.marrow",
            "entity.name.type.marrow"
          ],
          "enumMember": [
            "constant.other.enum.marrow",
            "variable.other.enummember.marrow"
          ],
          "property": [
            "variable.other.property.marrow"
          ],
          "parameter": [
            "variable.parameter.marrow"
          ],
          "keyword": [
            "keyword.control.marrow",
            "keyword.declaration.marrow",
            "storage.modifier.marrow"
          ],
          "booleanLiteral": [
            "constant.language.boolean.marrow"
          ],
          "variable": [
            "variable.other.marrow"
          ],
          "string": [
            "string.quoted.double.marrow",
            "string.quoted.double.bytes.marrow",
            "string.quoted.double.interpolated.marrow"
          ],
          "number": [
            "constant.numeric.integer.marrow",
            "constant.numeric.decimal.marrow"
          ],
          "comment": [
            "comment.block.documentation.marrow",
            "comment.line.semicolon.marrow"
          ],
          "type": [
            "support.type.primitive.marrow",
            "support.type.error.marrow",
            "entity.name.type.marrow"
          ],
          "type.defaultLibrary": [
            "support.type.builtin.marrow",
            "entity.name.type.marrow"
          ],
          "operator": [
            "keyword.operator.marrow",
            "keyword.operator.logical.marrow",
            "keyword.operator.optional.marrow",
            "keyword.operator.range.marrow",
            "keyword.operator.comparison.marrow",
            "keyword.operator.assignment.marrow",
            "keyword.operator.arithmetic.marrow",
            "keyword.operator.concat.marrow"
          ],
          "savedRoot": [
            "variable.other.saved.marrow",
            "variable.other.marrow"
          ]
        }
      }
    ],
    "debuggers": [
      {
        "type": "marrow",
        "label": "Marrow",
        "languages": [
          "marrow"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "project": {
                "type": "string",
                "description": "Path to the Marrow project (the directory containing marrow.json).",
                "default": "${workspaceFolder}"
              },
              "entry": {
                "type": "string",
                "description": "Debug/admin prototype entry string, such as `module::function`. F5 remains usable for launch and stepping, but this string is not a stable production entry API until Marrow exposes canonical function-entry facts. When omitted, the adapter uses `defaultEntry` from marrow.json."
              },
              "args": {
                "type": "array",
                "description": "Prototype launch arguments for the Marrow entry. Non-empty values are blocked by default until Marrow exposes typed launch argument facts; set allowPrototypeArgs to use the debug/admin scalar decoder.",
                "items": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                },
                "default": []
              },
              "allowPrototypeArgs": {
                "type": "boolean",
                "description": "Allow scalar launch args through the debug/admin prototype decoder. This is blocked on typed launch argument facts from Marrow.",
                "default": false
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Break at the first statement of the entry.",
                "default": false
              },
              "allowRawDataInspection": {
                "type": "boolean",
                "description": "Expose raw saved-data debugger inspection (^ Durable Data scope and ^ watch expressions). This is a debug/admin prototype blocked on typed durable watch/path facts from Marrow.",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "marrow",
            "request": "launch",
            "name": "Debug Marrow entry",
            "project": "${workspaceFolder}",
            "args": [],
            "allowPrototypeArgs": false,
            "stopOnEntry": false,
            "allowRawDataInspection": false
          }
        ],
        "configurationSnippets": [
          {
            "label": "Marrow: Debug entry",
            "description": "Debug a Marrow entry with the debug/admin prototype entry string while canonical function-entry facts are pending.",
            "body": {
              "type": "marrow",
              "request": "launch",
              "name": "Debug Marrow entry",
              "project": "^\"\\${workspaceFolder}\"",
              "entry": "^\"module::function\"",
              "args": [],
              "allowPrototypeArgs": false,
              "stopOnEntry": false,
              "allowRawDataInspection": false
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "Marrow",
      "properties": {
        "marrow.server.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to an existing `marrow-lsp` server binary. When empty, the extension uses the bundled `./server/marrow-lsp` if present. Extension development hosts may also fall back to `../../target/debug/marrow-lsp`."
        },
        "marrow.dap.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to an existing `marrow-dap` debug adapter binary. When empty, the extension uses the bundled `./server/marrow-dap` if present. Extension development hosts may also fall back to `../../target/debug/marrow-dap`."
        },
        "marrow.liveData": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Opt in to debug/admin read-only native dev-store reads for hover, presentation-only CodeLens and Data Explorer surfaces, and advisory stored-data integrity checks. Leave disabled to prevent editor-triggered reads of local stored data."
        }
      }
    }
  },
  "scripts": {
    "compile": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "compile:release": "esbuild ./src/extension.ts --bundle --minify --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "vscode:prepublish": "npm run compile:release",
    "check": "node ./scripts/checkGrammar.mjs && tsc --noEmit && npm run check:dataExplorer && npm run check:copy",
    "check:dataExplorer": "node ./scripts/checkDataExplorer.mjs",
    "check:copy": "node ./scripts/checkCopy.mjs",
    "bundle": "node ./scripts/bundle.mjs",
    "package": "npm run compile:release && npm run bundle && npx @vscode/vsce package --no-dependencies --target $(node -e \"console.log({darwin:{arm64:'darwin-arm64',x64:'darwin-x64'},linux:{arm64:'linux-arm64',x64:'linux-x64'},win32:{x64:'win32-x64'}}[process.platform][process.arch])\")"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  }
}
