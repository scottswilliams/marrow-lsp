{
  "name": "marrow",
  "displayName": "Marrow",
  "description": "Language support for the Marrow .mw language, backed by the marrow-lsp server.",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "publisher": "scottswilliams",
  "repository": {
    "type": "git",
    "url": "https://github.com/scottswilliams/marrow-lsp"
  },
  "bugs": {
    "url": "https://github.com/scottswilliams/marrow-lsp/issues"
  },
  "homepage": "https://github.com/scottswilliams/marrow-lsp#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:marrow",
    "workspaceContains:**/marrow.json",
    "onDebugResolve:marrow",
    "onDebugDynamicConfigurations:marrow"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "marrow",
          "title": "Marrow",
          "icon": "$(database)"
        }
      ]
    },
    "views": {
      "marrow": [
        {
          "id": "marrowData",
          "name": "Saved Resource Inspector"
        }
      ]
    },
    "commands": [
      {
        "command": "marrow.refreshData",
        "title": "Refresh Saved Data",
        "category": "Marrow",
        "icon": "$(refresh)"
      },
      {
        "command": "marrow.revealSavedResource",
        "title": "Reveal Saved Resource",
        "category": "Marrow",
        "icon": "$(target)"
      },
      {
        "command": "marrow.checkDataIntegrity",
        "title": "Marrow: Check Stored Data Integrity (Advisory)",
        "category": "Marrow"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "marrow.refreshData",
          "when": "view == marrowData",
          "group": "navigation"
        },
        {
          "command": "marrow.revealSavedResource",
          "when": "view == marrowData",
          "group": "navigation"
        }
      ]
    },
    "languages": [
      {
        "id": "marrow",
        "aliases": [
          "Marrow"
        ],
        "extensions": [
          ".mw"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/marrow.svg",
          "dark": "./icons/marrow.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "marrow",
        "scopeName": "source.marrow",
        "path": "./syntaxes/marrow.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[marrow]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "semanticTokenTypes": [
      {
        "id": "savedRoot",
        "superType": "variable",
        "description": "Saved data root"
      },
      {
        "id": "booleanLiteral",
        "superType": "keyword",
        "description": "Boolean literal"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "marrow",
        "scopes": {
          "namespace": [
            "entity.name.namespace.marrow"
          ],
          "namespace.defaultLibrary": [
            "support.namespace.builtin.marrow",
            "entity.name.namespace.marrow"
          ],
          "function": [
            "entity.name.function.marrow"
          ],
          "function.defaultLibrary": [
            "support.function.builtin.marrow",
            "entity.name.function.marrow"
          ],
          "struct": [
            "entity.name.type.struct.marrow",
            "entity.name.type.resource.marrow",
            "entity.name.type.marrow"
          ],
          "enum": [
            "entity.name.type.enum.marrow",
            "entity.name.type.marrow"
          ],
          "enumMember": [
            "constant.other.enum.marrow",
            "variable.other.enummember.marrow"
          ],
          "property": [
            "variable.other.property.marrow"
          ],
          "parameter": [
            "variable.parameter.marrow"
          ],
          "keyword": [
            "keyword.control.marrow",
            "keyword.declaration.marrow",
            "storage.modifier.marrow"
          ],
          "booleanLiteral": [
            "constant.language.boolean.marrow"
          ],
          "variable": [
            "variable.other.marrow"
          ],
          "variable.readonly": [
            "variable.other.constant.marrow",
            "variable.other.readonly.marrow",
            "variable.other.marrow"
          ],
          "string": [
            "string.quoted.double.marrow",
            "string.quoted.double.bytes.marrow",
            "string.quoted.double.interpolated.marrow"
          ],
          "number": [
            "constant.numeric.integer.marrow",
            "constant.numeric.decimal.marrow"
          ],
          "comment": [
            "comment.block.documentation.marrow",
            "comment.line.semicolon.marrow"
          ],
          "type": [
            "support.type.primitive.marrow",
            "support.type.error.marrow",
            "entity.name.type.marrow"
          ],
          "type.defaultLibrary": [
            "support.type.builtin.marrow",
            "entity.name.type.marrow"
          ],
          "operator": [
            "keyword.operator.marrow",
            "keyword.operator.logical.marrow",
            "keyword.operator.optional.marrow",
            "keyword.operator.range.marrow",
            "keyword.operator.comparison.marrow",
            "keyword.operator.assignment.marrow",
            "keyword.operator.arithmetic.marrow",
            "keyword.operator.concat.marrow"
          ],
          "savedRoot": [
            "variable.other.saved.marrow",
            "variable.other.marrow"
          ]
        }
      }
    ],
    "debuggers": [
      {
        "type": "marrow",
        "label": "Marrow",
        "languages": [
          "marrow"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "project": {
                "type": "string",
                "description": "Path to the Marrow project (the directory containing marrow.json).",
                "default": "${workspaceFolder}"
              },
              "entry": {
                "type": "string",
                "description": "Entry selector such as module::fn. Omit to use defaultEntry from marrow.json."
              },
              "args": {
                "type": "array",
                "description": "Typed named arguments for the Marrow entry. Each item has a parameter name and a typed value object.",
                "items": {
                  "$ref": "#/$defs/entryArgument"
                },
                "default": []
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Break at the first statement of the entry.",
                "default": true
              }
            },
            "$defs": {
              "entryArgument": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S",
                    "description": "Entry parameter name."
                  },
                  "value": {
                    "$ref": "#/$defs/entryValue",
                    "description": "Typed value object admitted by Marrow through the debug adapter. Scalar int, date, and bytes values use exact string forms."
                  }
                },
                "required": ["name", "value"],
                "additionalProperties": false
              },
              "entryScalar": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": { "const": "int" },
                      "value": { "type": "string" }
                    },
                    "required": ["kind", "value"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": { "const": "bool" },
                      "value": { "type": "boolean" }
                    },
                    "required": ["kind", "value"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": { "const": "string" },
                      "value": { "type": "string" }
                    },
                    "required": ["kind", "value"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": { "const": "decimal" },
                      "value": { "type": "string" }
                    },
                    "required": ["kind", "value"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": { "const": "date" },
                      "value": { "type": "string" }
                    },
                    "required": ["kind", "value"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": { "const": "instant" },
                      "value": { "type": "string" }
                    },
                    "required": ["kind", "value"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": { "const": "duration" },
                      "value": { "type": "string" }
                    },
                    "required": ["kind", "value"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": { "const": "bytes" },
                      "value": {
                        "type": "string",
                        "pattern": "^([0-9a-f]{2})*$"
                      }
                    },
                    "required": ["kind", "value"],
                    "additionalProperties": false
                  }
                ]
              },
              "entryValue": {
                "oneOf": [
                  { "$ref": "#/$defs/entryScalar/oneOf/0" },
                  { "$ref": "#/$defs/entryScalar/oneOf/1" },
                  { "$ref": "#/$defs/entryScalar/oneOf/2" },
                  { "$ref": "#/$defs/entryScalar/oneOf/3" },
                  { "$ref": "#/$defs/entryScalar/oneOf/4" },
                  { "$ref": "#/$defs/entryScalar/oneOf/5" },
                  { "$ref": "#/$defs/entryScalar/oneOf/6" },
                  { "$ref": "#/$defs/entryScalar/oneOf/7" },
                  {
                    "type": "object",
                    "properties": {
                      "kind": { "const": "enum_member" },
                      "member_catalog_id": {
                        "type": "string",
                        "pattern": "^cat_[0-9a-f]{32}$"
                      }
                    },
                    "required": ["kind", "member_catalog_id"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": { "const": "identity" },
                      "store_catalog_id": {
                        "type": "string",
                        "pattern": "^cat_[0-9a-f]{32}$"
                      },
                      "keys": {
                        "type": "array",
                        "items": { "$ref": "#/$defs/entryScalar" }
                      }
                    },
                    "required": ["kind", "store_catalog_id", "keys"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": { "const": "sequence" },
                      "value": {
                        "type": "array",
                        "items": { "$ref": "#/$defs/entryValue" }
                      }
                    },
                    "required": ["kind", "value"],
                    "additionalProperties": false
                  }
                ]
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "marrow",
            "request": "launch",
            "name": "Debug default Marrow entry",
            "project": "${workspaceFolder}",
            "args": [],
            "stopOnEntry": true
          }
        ],
        "configurationSnippets": [
          {
            "label": "Marrow: Debug default entry",
            "description": "Debug the defaultEntry from marrow.json. Set entry in launch.json to choose another entry.",
            "body": {
              "type": "marrow",
              "request": "launch",
              "name": "Debug default Marrow entry",
              "project": "^\"\\${workspaceFolder}\"",
              "args": [],
              "stopOnEntry": true
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "Marrow",
      "properties": {
        "marrow.server.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to an existing `marrow-lsp` server binary. When empty, the extension uses the bundled `./server/marrow-lsp` if present. Extension development hosts may also fall back to `../../target/debug/marrow-lsp`."
        },
        "marrow.dap.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to an existing `marrow-dap` debug adapter binary. When empty, the extension uses the bundled `./server/marrow-dap` if present. Extension development hosts may also fall back to `../../target/debug/marrow-dap`."
        },
        "marrow.liveData": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Opt in to the production read-only data-view contract for the Saved Resource Inspector and to advisory stored-data integrity checks over native dev-store reads. Leave disabled to prevent editor-triggered reads of local stored data."
        }
      }
    }
  },
  "scripts": {
    "compile": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "compile:release": "esbuild ./src/extension.ts --bundle --minify --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "vscode:prepublish": "npm run compile:release",
    "check": "node ./scripts/checkGrammar.mjs && tsc --noEmit && npm run check:dataIntegrity && npm run check:savedResourceInspector && npm run check:copy && npm run check:bundleSmoke",
    "check:dataIntegrity": "node ./scripts/checkDataIntegrity.mjs",
    "check:savedResourceInspector": "node ./scripts/checkSavedResourceInspector.mjs",
    "check:copy": "node ./scripts/checkCopy.mjs",
    "check:bundleSmoke": "node ./scripts/checkBundleSmoke.mjs",
    "bundle": "node ./scripts/bundle.mjs",
    "package:vsix": "vsce package --no-dependencies",
    "package": "node ./scripts/package.mjs"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.1",
    "typescript": "^5.3.0"
  }
}
