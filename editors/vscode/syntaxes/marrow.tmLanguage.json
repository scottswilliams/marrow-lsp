{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Marrow",
  "scopeName": "source.marrow",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#saved-sigil" },
    { "include": "#stable-id" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#namespace-path" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.marrow",
          "match": ";;.*$"
        },
        {
          "name": "comment.line.semicolon.marrow",
          "match": ";.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        { "include": "#interpolated-string" },
        { "include": "#bytes-string" },
        { "include": "#plain-string" }
      ]
    },
    "plain-string": {
      "name": "string.quoted.double.marrow",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.marrow" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.marrow" }
      },
      "patterns": [
        { "include": "#string-escape" }
      ]
    },
    "bytes-string": {
      "name": "string.quoted.double.bytes.marrow",
      "begin": "b\"",
      "end": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.marrow" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.marrow" }
      },
      "patterns": [
        { "include": "#string-escape" }
      ]
    },
    "interpolated-string": {
      "name": "string.quoted.double.interpolated.marrow",
      "begin": "\\$\"",
      "end": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.marrow" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.marrow" }
      },
      "patterns": [
        {
          "name": "constant.character.escape.brace.marrow",
          "match": "\\{\\{|\\}\\}"
        },
        {
          "name": "meta.interpolation.marrow",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": { "name": "punctuation.section.interpolation.begin.marrow" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.section.interpolation.end.marrow" }
          },
          "patterns": [
            { "include": "#interpolation-expression" }
          ]
        },
        { "include": "#string-escape" }
      ]
    },
    "string-escape": {
      "name": "constant.character.escape.marrow",
      "match": "\\\\."
    },
    "interpolation-expression": {
      "patterns": [
        { "include": "#strings" },
        { "include": "#saved-sigil" },
        { "include": "#keywords" },
        { "include": "#types" },
        { "include": "#constants" },
        { "include": "#numbers" },
        { "include": "#namespace-path" },
        { "include": "#operators" },
        { "include": "#punctuation" }
      ]
    },
    "saved-sigil": {
      "match": "(\\^)([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.operator.saved.sigil.marrow" },
        "2": { "name": "variable.other.saved.marrow" }
      }
    },
    "stable-id": {
      "name": "meta.annotation.id.marrow",
      "match": "(@id)\\b",
      "captures": {
        "1": { "name": "storage.modifier.annotation.marrow" }
      }
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.marrow",
          "match": "\\b(if|else|while|for|in|break|continue|return|transaction|lock|try|catch|finally|throw|delete|merge)\\b"
        },
        {
          "name": "keyword.declaration.marrow",
          "match": "\\b(module|use|pub|fn|resource|at|index|unique|required|const|var|sequence)\\b"
        },
        {
          "name": "storage.modifier.marrow",
          "match": "\\b(out|inout)\\b"
        },
        {
          "name": "keyword.operator.logical.marrow",
          "match": "\\b(not|and|or)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.marrow",
          "match": "\\b(int|decimal|bool|string|bytes|date|instant|duration|ErrorCode|unknown)\\b"
        },
        {
          "name": "support.type.error.marrow",
          "match": "\\bError\\b"
        }
      ]
    },
    "constants": {
      "name": "constant.language.boolean.marrow",
      "match": "\\b(true|false)\\b"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.decimal.marrow",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.marrow",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "namespace-path": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(::)",
          "captures": {
            "1": { "name": "entity.name.namespace.marrow" },
            "2": { "name": "punctuation.separator.namespace.marrow" }
          }
        },
        {
          "match": "(::)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.separator.namespace.marrow" },
            "2": { "name": "entity.name.type.namespace.marrow" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.optional.marrow",
          "match": "\\?\\.|\\?\\?"
        },
        {
          "name": "keyword.operator.range.marrow",
          "match": "\\.\\.=|\\.\\."
        },
        {
          "name": "keyword.operator.comparison.marrow",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.marrow",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.marrow",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.concat.marrow",
          "match": "(?<=\\s)_(?=\\s)"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.accessor.marrow",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.comma.marrow",
          "match": ","
        },
        {
          "name": "punctuation.separator.colon.marrow",
          "match": ":"
        }
      ]
    }
  }
}
